@model List<SrChauferoMVC_AzureIA.ViewModels.CarritoItemViewModel>
@{
    var total = Model.Sum(x => x.Subtotal);
    int? mesa = ViewBag.MesaSeleccionada as int?;
    string tipoPedido = ViewBag.TipoPedido as string ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold">🛒 Mi pedido</h2>
        <p class="text-muted mb-0">Revisa tus platos seleccionados antes de continuar con el pago QR.</p>
    </div>
    <a asp-controller="Platos" asp-action="Index" class="btn btn-outline-primary">Agregar más platos</a>
</div>

@if (tipoPedido == "Presencial")
{
    <div class="alert alert-info">Tipo de pedido: <strong>Comer aquí</strong> | Mesa seleccionada: <strong>@mesa</strong></div>
}
else if (tipoPedido == "Para llevar")
{
    <div class="alert alert-info">Tipo de pedido: <strong>Para llevar</strong></div>
}
else
{
    <div class="alert alert-warning">Aún no seleccionaste si comerás en el local o si será para llevar.</div>
}

@if (!Model.Any())
{
    <div class="card p-4 text-center">
        <h4>No hay platos en tu pedido.</h4>
        <p class="text-muted">Ingresa a la carta y agrega platos para consumir.</p>
        <a asp-controller="Platos" asp-action="Index" class="btn btn-primary">Ver platos</a>
    </div>
}
else
{
    <div class="card p-3">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Plato</th>
                    <th>Precio</th>
                    <th>Cantidad</th>
                    <th>Subtotal</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Nombre</td>
                        <td>S/ @item.Precio.ToString("0.00")</td>
                        <td>@item.Cantidad</td>
                        <td>S/ @item.Subtotal.ToString("0.00")</td>
                        <td class="text-end">
                            <form asp-controller="Cliente" asp-action="Quitar" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="platoId" value="@item.PlatoId" />
                                <button class="btn btn-sm btn-outline-danger">Quitar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-between align-items-center border-top pt-3 flex-wrap gap-2">
            <h4>Total: <strong>S/ @total.ToString("0.00")</strong></h4>
            <form asp-controller="Cliente" asp-action="Pagar" method="post">
                @Html.AntiForgeryToken()
                <button class="btn btn-success btn-lg">Continuar con el pago</button>
            </form>
        </div>
    </div>
}
