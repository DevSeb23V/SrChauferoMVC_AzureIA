@model List<SrChauferoMVC_AzureIA.ViewModels.CarritoItemViewModel>

@{
    var total = Model.Sum(x => x.Subtotal);
    string tipoPedido = ViewBag.TipoPedido as string ?? "";
    int? mesa = ViewBag.MesaSeleccionada as int?;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold">🛒 Confirmar pedido</h2>

    <div class="d-flex gap-2">
        <a asp-controller="Platos" asp-action="Index" class="btn btn-outline-primary">
            Regresar
        </a>

        <form asp-controller="Cliente" asp-action="CancelarPedido" method="post"
              onsubmit="return confirm('¿Seguro que deseas cancelar tu pedido?');">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-danger">Cancelar pedido</button>
        </form>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card p-4 shadow-sm border-0">
            <h4>Detalle del pedido</h4>

            @if (!Model.Any())
            {
                <div class="alert alert-warning mt-3">
                    No tienes platos agregados.
                </div>
            }
            else
            {
                <table class="table align-middle mt-3">
                    <thead>
                        <tr>
                            <th>Plato</th>
                            <th>Precio</th>
                            <th>Cantidad</th>
                            <th>Subtotal</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Nombre</td>
                                <td>S/ @item.Precio.ToString("0.00")</td>
                                <td>@item.Cantidad</td>
                                <td>S/ @item.Subtotal.ToString("0.00")</td>
                                <td>
                                    <form asp-controller="Cliente" asp-action="Quitar" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="platoId" value="@item.PlatoId" />
                                        <button class="btn btn-sm btn-outline-danger">Quitar</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card p-4 shadow-sm border-0">
            <h4>Resumen</h4>

            <p><strong>Tipo:</strong> @tipoPedido</p>

            @if (tipoPedido == "Presencial")
            {
                <p><strong>Mesa:</strong> @mesa</p>
            }

            <hr />

            <h3>Total: S/ @total.ToString("0.00")</h3>

            <form asp-controller="Cliente" asp-action="Pagar" method="post" class="mt-3">
                @Html.AntiForgeryToken()

                <label class="form-label">Tu nombre</label>
                <input name="nombreCliente" class="form-control mb-3" placeholder="Ejemplo: Sebastián" required />

                <div class="alert alert-info">
                    Pago simulado con QR para fines académicos.
                </div>

                <button class="btn btn-success btn-lg w-100">
                    Pagar
                </button>
            </form>
        </div>
    </div>
</div>