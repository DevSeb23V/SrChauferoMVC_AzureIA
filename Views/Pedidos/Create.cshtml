@model Pedido

<h2 class="fw-bold">
    📋 Registrar Pedido
</h2>

<form method="post" class="card p-4">

    <div class="row g-3">

        <div class="col-md-4">
            <label class="form-label">
                Cliente
            </label>

            <input asp-for="Cliente"
                   class="form-control" />
        </div>

        <div class="col-md-4">
            <label class="form-label">
                Mesa
            </label>

            <input asp-for="Mesa"
                   class="form-control" />
        </div>

        <div class="col-md-4">
            <label class="form-label">
                Total
            </label>

            <input asp-for="Total"
                   class="form-control" />
        </div>

    </div>

    <button type="submit"
            class="btn btn-primary mt-3">
        Registrar Pedido
    </button>

</form>