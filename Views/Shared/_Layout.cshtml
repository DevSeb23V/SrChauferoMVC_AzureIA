@{
    var rol = Context.Session.GetString("Rol");
    var nombre = Context.Session.GetString("Nombre") ?? Context.Session.GetString("Usuario");
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Sr. Chaufero</title>


    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">


    <link rel="stylesheet" href="~/css/site.css" />

</head>


<body>


    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">

        <div class="container-fluid container-lg">


            @if (rol == "Cliente")
            {
                <span class="navbar-brand fw-bold">
                    🍛 Sr. Chaufero
                </span>
            }
            else
            {
                <a class="navbar-brand fw-bold"
                   asp-controller="@(rol == "Cocinero" ? "Cocina" : rol == "Mozo" ? "Mozo" : "Home")"
                   asp-action="Index">

                    🍛 Sr. Chaufero

                </a>
            }



            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#nav"
                    aria-controls="nav"
                    aria-expanded="false">

                <span class="navbar-toggler-icon"></span>

            </button>



            <div id="nav" class="collapse navbar-collapse">


                <ul class="navbar-nav me-auto">


                    @if (rol == "Administrador")
                    {

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Dashboard
                            </a>
                        </li>


                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Platos"
                               asp-action="Index">
                                Platos
                            </a>
                        </li>


                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Pedidos"
                               asp-action="Index">
                                Pedidos
                            </a>
                        </li>


                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Mesas"
                               asp-action="Index">
                                Mesas
                            </a>
                        </li>


                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Cocina"
                               asp-action="Index">
                                Cocina
                            </a>
                        </li>


                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Reportes"
                               asp-action="Index">
                                Reportes
                            </a>
                        </li>


                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Usuario"
                               asp-action="Index">
                                Usuarios
                            </a>
                        </li>

                    }



                    else if (rol == "Cocinero")
                    {

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Cocina"
                               asp-action="Index">

                                Cocina

                            </a>

                        </li>

                    }



                    else if (rol == "Mozo")
                    {

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Mozo"
                               asp-action="Index">

                                Pedidos

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Mesas"
                               asp-action="Index">

                                Mesas

                            </a>

                        </li>

                    }


                </ul>




                <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">


                    @if (!string.IsNullOrWhiteSpace(nombre))
                    {

                        <span class="navbar-text text-white-50 small">

                            @nombre (@rol)

                        </span>

                    }



                    <a class="btn btn-warning btn-sm"
                       asp-controller="Account"
                       asp-action="Logout">

                        Salir

                    </a>


                </div>


            </div>


        </div>


    </nav>





    <main class="container py-4">


        @if (TempData["Ok"] != null)
        {

            <div class="alert alert-success">

                @TempData["Ok"]

            </div>

        }



        @if (TempData["Error"] != null)
        {

            <div class="alert alert-danger">

                @TempData["Error"]

            </div>

        }



        @RenderBody()


    </main>





    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


    @await RenderSectionAsync("Scripts", required: false)






    @if (rol == "Administrador" ||
         rol == "Cocinero" ||
         rol == "Mozo" ||
         rol == "Cliente")
    {


        <div id="iaBoton" class="ia-boton">
            🤖
        </div>




        <div id="iaChat" class="ia-chat">


            <div class="ia-header">

                <strong>
                    Asistente IA
                </strong>


                <button onclick="cerrarIA()">

                    ×

                </button>


            </div>




            <div id="iaMensajes" class="ia-mensajes">

                <div class="ia-msg bot">

                    Hola, soy tu asistente del restaurante.

                </div>

            </div>




            <div class="ia-input">


                <input id="iaTexto"
                       placeholder="Escribe una consulta..." />



                <button onclick="enviarIA()">

                    ➤

                </button>


            </div>


        </div>





        <script>


            document.getElementById("iaBoton").onclick = function ()
            {

            document.getElementById("iaChat").style.display = "flex";

            };



            function cerrarIA()
            {

            document.getElementById("iaChat").style.display = "none";

            }




            async function enviarIA()
            {

            const input = document.getElementById("iaTexto");

            const mensajes = document.getElementById("iaMensajes");


            const texto = input.value.trim();



            if(!texto)
            return;




            mensajes.innerHTML +=
            `<div class="ia-msg user">${texto}</div>`;



            input.value = "";




            const res = await fetch("/IA/Chat",
            {

            method:"POST",

            headers:
            {
            "Content-Type":"application/json"
            },


            body:JSON.stringify(
            {
            mensaje:texto
            })

            });





            const data = await res.json();




            mensajes.innerHTML +=
            `<div class="ia-msg bot">${data.respuesta}</div>`;



            mensajes.scrollTop = mensajes.scrollHeight;


            }


        </script>


    }


</body>

</html>