@model IEnumerable<Mesa>
@{
    var rol = Context.Session.GetString("Rol");
    var esUsuario = rol == "Usuario";
    var tipoPedido = Context.Session.GetString("TipoPedido");
    var mesaSeleccionada = Context.Session.GetInt32("MesaSeleccionada");
}

<h2 class="fw-bold mb-3">🪑 Mesas</h2>

@if (esUsuario)
{
    <div class="card p-4 mb-4 border-0 shadow-sm">
        <h4 class="fw-bold mb-3">¿Cómo deseas realizar tu pedido?</h4>
        <p class="text-muted">Selecciona si vas a comer en el restaurante o si tu pedido será para llevar.</p>

        <div class="row g-3">
            <div class="col-md-6">
                <form asp-controller="Cliente" asp-action="SetTipoPedido" method="post" class="d-grid">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="tipo" value="Presencial" />
                    <button type="submit" class="btn @(tipoPedido == "Presencial" ? "btn-success" : "btn-outline-success") btn-lg">
                        Comer aquí
                    </button>
                </form>
            </div>
            <div class="col-md-6">
                <form asp-controller="Cliente" asp-action="SetTipoPedido" method="post" class="d-grid">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="tipo" value="Para llevar" />
                    <button type="submit" class="btn @(tipoPedido == "Para llevar" ? "btn-success" : "btn-outline-success") btn-lg">
                        Para llevar
                    </button>
                </form>
            </div>
        </div>
    </div>

    @if (tipoPedido == "Presencial")
    {
        <p class="text-muted">Elige una mesa libre para asociarla a tu pedido. Después podrás continuar con la selección de platos.</p>

        @if (mesaSeleccionada != null)
        {
            <div class="alert alert-info d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span>Mesa seleccionada actualmente: <strong>@mesaSeleccionada</strong></span>
                <a asp-controller="Platos" asp-action="Index" class="btn btn-primary">Continuar con platos</a>
            </div>
        }
        else
        {
            <div class="alert alert-warning">Selecciona una mesa libre para continuar.</div>
        }
    }
    else if (tipoPedido == "Para llevar")
    {
        <div class="alert alert-info d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>Pedido configurado como <strong>para llevar</strong>. No necesitas elegir mesa.</span>
            <a asp-controller="Platos" asp-action="Index" class="btn btn-primary">Continuar con platos</a>
        </div>
    }
    else
    {
        <div class="alert alert-warning">Primero selecciona si vas a comer aquí o si tu pedido será para llevar.</div>
    }
}
else
{
    <p class="text-muted">Administra el estado de las mesas, registra clientes, número de personas y hora de ingreso.</p>
}

@if (!esUsuario || tipoPedido == "Presencial")
{
    <div class="row g-4">
        @foreach (var mesa in Model)
        {
            var ocupada = mesa.Estado == "Ocupada";

            <div class="col-md-6 col-lg-3">
                <div class="card mesa-card h-100 shadow-sm border-0">
                    <div class="card-body text-center">
                        <h3 class="fw-bold mb-2">Mesa @mesa.Numero</h3>

                        <span class="badge w-100 py-2 @(ocupada ? "bg-danger" : "bg-success")">@mesa.Estado</span>

                        <p class="mt-3 mb-1">Capacidad: <strong>@mesa.Capacidad</strong></p>

                        @if (ocupada)
                        {
                            <div class="text-start bg-light rounded p-3 mt-3">
                                <p class="mb-1"><strong>Cliente:</strong> @mesa.Cliente</p>
                                <p class="mb-1"><strong>Personas:</strong> @mesa.Personas</p>
                                <p class="mb-0"><strong>Ingreso:</strong> @mesa.HoraIngreso?.ToString("dd/MM/yyyy HH:mm")</p>
                            </div>

                            @if (rol == "Administrador")
                            {
                                <form asp-action="Liberar" method="post" class="mt-3">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@mesa.Id" />
                                    <button type="submit" class="btn btn-warning w-100">Liberar Mesa</button>
                                </form>
                            }
                        }
                        else
                        {
                            @if (rol == "Administrador")
                            {
                                <form asp-action="Ocupar" method="post" class="mt-3 text-start">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@mesa.Id" />

                                    <label class="form-label">Cliente</label>
                                    <input name="cliente" class="form-control" placeholder="Carlos Ruiz" required />

                                    <label class="form-label mt-2">Personas</label>
                                    <input name="personas" type="number" min="1" max="@mesa.Capacidad" class="form-control" placeholder="4" required />

                                    <button type="submit" class="btn btn-primary w-100 mt-3">Ocupar Mesa</button>
                                </form>
                            }
                            else if (esUsuario)
                            {
                                <form asp-controller="Cliente" asp-action="ElegirMesa" method="post" class="mt-3">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@mesa.Id" />
                                    <button type="submit" class="btn btn-primary w-100">Elegir esta mesa</button>
                                </form>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
