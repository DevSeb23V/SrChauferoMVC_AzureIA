@model IEnumerable<Mesa>

@{
    var rol = Context.Session.GetString("Rol");
    var esCliente = rol == "Cliente";
    var esAdminOMozo = rol == "Administrador" || rol == "Mozo";
    var tipoPedido = Context.Session.GetString("TipoPedido");
    var mesaSeleccionada = Context.Session.GetInt32("MesaSeleccionada");
}

<h2 class="fw-bold mb-3">🪑 Mesas</h2>

@if (esCliente)
{
    <div class="card p-4 mb-4 border-0 shadow-sm">
        <h4 class="fw-bold mb-3">¿Cómo deseas realizar tu pedido?</h4>
        <p class="text-muted">Selecciona si vas a comer en el restaurante o si tu pedido será para llevar.</p>

        <div class="row g-3">
            <div class="col-12 col-md-6">
                <form asp-controller="Cliente" asp-action="SetTipoPedido" method="post" class="d-grid">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="tipo" value="Presencial" />
                    <button type="submit" class="btn @(tipoPedido == "Presencial" ? "btn-success" : "btn-outline-success") btn-lg">
                        Comer aquí
                    </button>
                </form>
            </div>

            <div class="col-12 col-md-6">
                <form asp-controller="Cliente" asp-action="SetTipoPedido" method="post" class="d-grid">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="tipo" value="Para llevar" />
                    <button type="submit" class="btn @(tipoPedido == "Para llevar" ? "btn-success" : "btn-outline-success") btn-lg">
                        Para llevar
                    </button>
                </form>
            </div>
        </div>
    </div>

    @if (tipoPedido == "Presencial")
    {
        @if (mesaSeleccionada != null)
        {
            <div class="alert alert-info d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span>Mesa seleccionada: <strong>@mesaSeleccionada</strong></span>
                <a asp-controller="Platos" asp-action="Index" class="btn btn-primary">Continuar con platos</a>
            </div>
        }
        else
        {
            <div class="alert alert-warning">Selecciona una mesa disponible para continuar.</div>
        }
    }
    else if (tipoPedido == "Para llevar")
    {
        <div class="alert alert-info d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>Pedido configurado como <strong>para llevar</strong>. No necesitas elegir mesa.</span>
            <a asp-controller="Platos" asp-action="Index" class="btn btn-primary">Continuar con platos</a>
        </div>
    }
}
else
{
    <p class="text-muted">
        Administra el estado de las mesas, clientes, pedidos en cocina y pedidos listos.
    </p>
}

@if (!esCliente || tipoPedido == "Presencial")
{
    <div class="row g-4">
        @foreach (var mesa in Model)
        {
            var disponible = mesa.Estado == "Disponible";

            if (esCliente)
            {
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card mesa-card h-100 shadow-sm border-0">
                        <div class="card-body text-center">
                            <h3 class="fw-bold mb-2">Mesa @mesa.Numero</h3>

                            @if (disponible)
                            {
                                <span class="badge w-100 py-2 bg-success">Disponible</span>

                                <p class="mt-3 mb-1">
                                    Capacidad: <strong>@mesa.Capacidad</strong>
                                </p>

                                <form asp-controller="Cliente" asp-action="ElegirMesa" method="post" class="mt-3">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@mesa.Id" />
                                    <button type="submit" class="btn btn-primary w-100">
                                        Elegir esta mesa
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="badge w-100 py-2 bg-danger">Ocupado</span>

                                <p class="mt-3 text-muted">
                                    Esta mesa no está disponible.
                                </p>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                string colorEstado = mesa.Estado switch
                {
                    "Disponible" => "bg-success",
                    "Cliente realizando pedido" => "bg-info text-dark",
                    "Pedido en cocina" => "bg-primary",
                    "Pedido listo" => "bg-warning text-dark",
                    "Atendido" => "bg-dark",
                    "Ocupada" => "bg-danger",
                    _ => "bg-secondary"
                };

                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card mesa-card h-100 shadow-sm border-0">
                        <div class="card-body text-center">
                            <h3 class="fw-bold mb-2">Mesa @mesa.Numero</h3>

                            <span class="badge w-100 py-2 @colorEstado">
                                @mesa.Estado
                            </span>

                            <p class="mt-3 mb-1">
                                Capacidad: <strong>@mesa.Capacidad</strong>
                            </p>

                            @if (!disponible)
                            {
                                <div class="text-start bg-light rounded p-3 mt-3">
                                    <p class="mb-1"><strong>Cliente:</strong> @(mesa.Cliente ?? "-")</p>
                                    <p class="mb-1"><strong>Personas:</strong> @(mesa.Personas == null ? "-" : mesa.Personas)</p>
                                    <p class="mb-0"><strong>Ingreso:</strong> @mesa.HoraIngreso?.ToString("dd/MM/yyyy HH:mm")</p>
                                </div>

                                @if (esAdminOMozo)
                                {
                                    <form asp-action="Liberar" method="post" class="mt-3"
                                          onsubmit="return confirm('¿Seguro que deseas liberar esta mesa?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@mesa.Id" />
                                        <button type="submit" class="btn btn-warning w-100">
                                            Liberar Mesa
                                        </button>
                                    </form>
                                }
                            }
                            else
                            {
                                @if (esAdminOMozo)
                                {
                                    <form asp-action="Ocupar" method="post" class="mt-3 text-start">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@mesa.Id" />

                                        <label class="form-label">Cliente</label>
                                        <input name="cliente" class="form-control" placeholder="Carlos Ruiz" required />

                                        <label class="form-label mt-2">Personas</label>
                                        <input name="personas" type="number" min="1" max="@mesa.Capacidad" class="form-control" placeholder="4" required />

                                        <button type="submit" class="btn btn-primary w-100 mt-3">
                                            Ocupar Mesa
                                        </button>
                                    </form>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
}

@if (esAdminOMozo)
{
    var delivery = ViewBag.Delivery as List<Pedido>;

    <hr class="my-5" />

    <h2 class="fw-bold mb-3">🥡 Pedidos para llevar</h2>

    <p class="text-muted">
        Aquí se muestran los pedidos que no tienen mesa asignada.
    </p>

    @if (delivery == null || !delivery.Any())
    {
        <div class="alert alert-info">
            No hay pedidos para llevar pendientes.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var pedido in delivery)
            {
                string colorPedido = pedido.EstadoPedido switch
                {
                    "EnviadoCocina" => "bg-warning text-dark",
                    "Cocinandose" => "bg-primary",
                    "Listo" => "bg-success",
                    "Atendido" => "bg-dark",
                    _ => "bg-secondary"
                };

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card shadow-sm border-0 h-100 p-3">
                        <div class="d-flex justify-content-between align-items-start mb-2 flex-wrap gap-2">
                            <h4 class="fw-bold mb-0">Pedido #@pedido.Id</h4>
                            <span class="badge @colorPedido">@pedido.EstadoPedido</span>
                        </div>

                        <p class="mb-1"><strong>Cliente:</strong> @pedido.Cliente</p>
                        <p class="mb-1"><strong>Hora:</strong> @pedido.Fecha.ToString("dd/MM/yyyy HH:mm")</p>
                        <p class="mb-1"><strong>Pago:</strong> @pedido.EstadoPago</p>
                        <p class="mb-3"><strong>Total:</strong> S/ @pedido.Total.ToString("0.00")</p>

                        <a asp-controller="Mozo"
                           asp-action="Detalle"
                           asp-route-id="@pedido.Id"
                           class="btn btn-outline-primary w-100">
                            Ver pedido
                        </a>
                    </div>
                </div>
            }
        </div>
    }
}