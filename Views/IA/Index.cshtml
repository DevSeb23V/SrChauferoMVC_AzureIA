<h2 class="fw-bold">
    🤖 Asistente IA
</h2>

<p class="text-muted">
    Este módulo consume Gemini para recomendar promociones,
    analizar ventas y consultar el estado de las mesas.
</p>

<!-- ==========================================
     FORMULARIO DE CONSULTA
========================================== -->

<form method="post" class="card p-4">

    <label class="form-label">
        Consulta para IA
    </label>

    <textarea name="consulta"
              class="form-control"
              rows="4">
¿Cuántas mesas están ocupadas actualmente?
    </textarea>

    <button type="submit"
            class="btn btn-primary mt-3">
        Generar recomendación
    </button>

</form>

<!-- ==========================================
     RESPUESTA DE LA IA
========================================== -->
@if (ViewBag.Respuesta != null)
{
    <div class="alert alert-warning mt-3">

        <strong>Respuesta IA:</strong>

        <br />

        @ViewBag.Respuesta

    </div>
}

<!-- ==========================================
     EJEMPLOS DE CONSULTAS
========================================== -->

<div class="card p-4 mt-3">

    <h5 class="fw-bold">
        📌 Preguntas de ejemplo
    </h5>

    <ul class="mb-0">
        <li>
            ¿Cuántas mesas están ocupadas actualmente?
        </li>

        <li>
            ¿Cuál es el porcentaje de ocupación del restaurante?
        </li>

        <li>
            Genera una promoción para el Chaufa especial.
        </li>
    </ul>

</div>