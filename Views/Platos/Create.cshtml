@model Plato

<h2 class="fw-bold mb-3">Registrar plato</h2>

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success">
        @TempData["Ok"]
    </div>
}

<form asp-action="Create" method="post" enctype="multipart/form-data" class="card p-4">

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger"></div>
    }


    <div class="row g-3">


        <div class="col-12 col-md-6">

            <label asp-for="Nombre" class="form-label">
                Nombre
            </label>

            <input asp-for="Nombre" class="form-control" />

            <span asp-validation-for="Nombre" class="text-danger"></span>

        </div>



        <div class="col-12 col-md-6">

            <label asp-for="Categoria" class="form-label">
                Categoría
            </label>

            <input asp-for="Categoria" class="form-control" />

            <span asp-validation-for="Categoria" class="text-danger"></span>

        </div>



        <div class="col-12 col-md-6">

            <label asp-for="Precio" class="form-label">
                Precio
            </label>

            <input asp-for="Precio"
                   class="form-control"
                   placeholder="25.00" />

            <span asp-validation-for="Precio"
                  class="text-danger"></span>

        </div>



        <div class="col-12 col-md-6">

            <label class="form-label">
                URL de imagen
            </label>


            <input asp-for="ImagenUrl"
                   class="form-control"
                   placeholder="https://ejemplo.com/plato.jpg" />


            <span asp-validation-for="ImagenUrl"
                  class="text-danger">
            </span>


        </div>


    </div>



    <div class="row mt-3 g-2">


        <div class="col-12 col-md-6">

            <button type="submit"
                    class="btn btn-primary w-100">

                Guardar

            </button>

        </div>



        <div class="col-12 col-md-6">

            <a asp-controller="Platos"
               asp-action="Index"
               class="btn btn-success w-100">

                Regresar

            </a>

        </div>


    </div>


</form>



@section Scripts {

    <script>

        function cambiarTextoDisponible(control){

            const texto = document.getElementById("textoDisponible");

            if(control.checked){
                texto.innerHTML="Disponible";
                texto.className="form-check-label fw-bold ms-2 text-success";
            }
            else{
                texto.innerHTML="No disponible";
                texto.className="form-check-label fw-bold ms-2 text-danger";
            }

        }

        document.addEventListener("DOMContentLoaded",function(){

            cambiarTextoDisponible(document.getElementById("switchDisponible"));

        });

    </script>

}