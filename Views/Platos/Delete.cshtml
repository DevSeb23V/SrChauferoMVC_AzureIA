@model Plato

<h2 class="fw-bold mb-3">Eliminar plato</h2>


@if (TempData["Ok"] != null)
{
    <div class="alert alert-success">
        @TempData["Ok"]
    </div>
}

<form asp-action="DeleteConfirmed" method="post" class="card p-4">
    <input asp-for="Id" type="hidden" />
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger"></div>
    }

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Nombre" class="form-label">Nombre</label>
            <input asp-for="Nombre" class="form-control" disabled />
        </div>

        <div class="col-md-6">
            <label asp-for="Categoria" class="form-label">Categoría</label>
            <input asp-for="Categoria" class="form-control" disabled />
        </div>

        <div class="col-md-6">
            <label asp-for="Precio" class="form-label">Precio</label>
            <input asp-for="Precio" class="form-control" placeholder="25.00" disabled />
        </div>

        <div class="col-md-6">
            <label class="form-label">Imagen del Plato</label>
            <input type="file" name="imagen" class="form-control" accept="image/*" disabled />
        </div>
        <div class="col-md-6 mt-4 mb-3">
            <div class="form-check mt-6">
                <input asp-for="Disponible" class="form-check-input" disabled />
                <label asp-for="Disponible" class="form-check-label" disabled>
                    Disponible 
                </label>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-6">
            <button type="submit" class="btn btn-danger w-100">
                Eliminar
            </button>
        </div>
        <div class="col-6">
            <a asp-controller="Platos" asp-action="Index" class="btn btn-success w-100">
                Regresar
            </a>
        </div>
    </div>
</form>