@model SrChauferoMVC_AzureIA.ViewModels.RegisterViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Crear perfil - Sr. Chaufero</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body>

    <div class="login-wrap">

        <div class="container">

            <div class="login-card register-card">

                <h2 class="fw-bold text-center">
                    👤 Crear perfil
                </h2>

                <p class="text-muted text-center">
                    Perfil de usuario para consumir en Sr. Chaufero
                </p>


                @if (Model?.Error != null)
                {
                    <div class="alert alert-danger">
                        @Model.Error
                    </div>
                }


                <form method="post">

                    <div asp-validation-summary="All" class="text-danger"></div>


                    <div class="mb-3">

                        <label class="form-label">
                            Nombre completo
                        </label>

                        <input asp-for="NombreCompleto"
                               class="form-control"
                               placeholder="Carlos Ruiz" />

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Usuario
                        </label>

                        <input asp-for="Usuario"
                               class="form-control"
                               placeholder="carlos" />

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Contraseña
                        </label>

                        <input asp-for="Password"
                               type="password"
                               class="form-control" />

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Confirmar contraseña
                        </label>

                        <input asp-for="ConfirmarPassword"
                               type="password"
                               class="form-control" />

                    </div>


                    <button type="submit"
                            class="btn btn-primary w-100 py-2">

                        Crear perfil e ingresar

                    </button>


                </form>


                <div class="text-center mt-3">

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-outline-warning w-100 mt-3 fw-bold">

                        Volver al login

                    </a>

                </div>


            </div>

        </div>

    </div>


</body>
</html>