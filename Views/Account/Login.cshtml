@model SrChauferoMVC_AzureIA.ViewModels.LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login - Sr. Chaufero</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="login-wrap">
        <div class="container">
            <div class="login-card">

                <h2 class="fw-bold text-center">🍛 Sr. Chaufero</h2>
                <p class="text-muted text-center">Acceso seguro con CAPTCHA</p>

                @if (Model?.Error != null)
                {
                    <div class="alert alert-danger">@Model.Error</div>
                }

                <form method="post">
                    <div class="mb-3">
                        <label class="form-label">Usuario</label>
                        <input asp-for="Usuario" class="form-control" placeholder="Ingresar su usuario" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Contraseña</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Ingrese su contraseña" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Captcha: ¿Cuánto es <b>@ViewBag.Captcha</b>?</label>
                        <input asp-for="CaptchaRespuesta" class="form-control" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2">Ingresar</button>
                </form>

            </div>
        </div>
    </div>
</body>
</html>
